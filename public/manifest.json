{
  "manifest_version": 3,
  "name": "ApexNav - 极奢 Bento 新标签页",
  "version": "1.0.0",
  "description": "macOS Bento 极奢高光新标签页，内置 8 大小组件、智能 AI 网址识别与 Cloudflare 云同步",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "ApexNav"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*/*"
  ]
}
